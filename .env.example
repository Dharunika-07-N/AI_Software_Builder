# Forge AI Configuration Settings

# LLM API keys (Optional. If missing, system operates in Deterministic Mock Mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Mode Configuration (set to false to force LLM usage, true to force deterministic mock)
MOCK_MODE=true

# Database Path
RUNTIME_DB_PATH=runtime.db
